# =============================================================================
# DocuSwarm Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in your actual values:
#   cp .env.example .env
#
# Priority: .env file > system environment variables > defaults
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Anthropic API Configuration
# -----------------------------------------------------------------------------
# Your Anthropic API key. Get one at: https://console.anthropic.com/
# This MUST be set — DocuSwarm will fail to start without it.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Anthropic API base URL. Only change if you use a custom endpoint or proxy.
# Default: https://api.anthropic.com/v1/
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1/

# -----------------------------------------------------------------------------
# OPTIONAL: Model Selection
# -----------------------------------------------------------------------------
# Primary model name. docuswarm reads this variable first and passes it
# explicitly to the Claude Agent SDK via ClaudeAgentOptions.model.
# Examples:
#   deepseek-v4-pro   (DeepSeek via https://api.deepseek.com/anthropic)
#   kimi-for-coding   (Kimi Code platform)
# ANTHROPIC_MODEL_NAME=deepseek-v4-pro
#
# Fallback: when ANTHROPIC_MODEL_NAME is unset, docuswarm will read
# ANTHROPIC_MODEL and pass it along. Even if both are unset, the bundled
# Claude Code CLI subprocess can still resolve ANTHROPIC_MODEL natively.
# ANTHROPIC_MODEL=deepseek-v4-pro

# -----------------------------------------------------------------------------
# OPTIONAL: DocuSwarm Runtime Configuration
# -----------------------------------------------------------------------------
# Path to the SQLite database file used for pipeline state persistence.
# Default: docuswarm.db (in project root)
# DOCUSWARM_DB_PATH=docuswarm.db

# Directory where pipeline output files are written.
# Default: output/
# DOCUSWARM_OUTPUT_DIR=output

# Logging level for DocuSwarm-specific loggers (DEBUG, INFO, WARNING, ERROR).
# Default: INFO
# DOCUSWARM_LOG_LEVEL=INFO

# Maximum number of iterations per pipeline node before forced termination.
# Default: 100
# DOCUSWARM_MAX_ITERATIONS=100

# Agent execution timeout in seconds.
# Default: 7200 (2 hours)
# DOCUSWARM_AGENT_TIMEOUT=7200

# -----------------------------------------------------------------------------
# OPTIONAL: General Logging
# -----------------------------------------------------------------------------
# Global Python log level. Affects all loggers, not just DocuSwarm.
# Default: INFO
# LOG_LEVEL=INFO
