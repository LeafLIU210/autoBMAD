# DocuSwarm Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED - You must set this before running the application
# =============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =============================================================================
# OPTIONAL - Environment Variables (these override YAML config)
# =============================================================================

# Database path (default: docuswarm.db)
# DOCUSWARM_DB_PATH=docuswarm.db

# Output directory (default: output)
# DOCUSWARM_OUTPUT_DIR=output

# Logging level (default: INFO, options: DEBUG, INFO, WARNING, ERROR)
# DOCUSWARM_LOG_LEVEL=INFO

# Maximum iterations for pipeline (default: 100)
# DOCUSWARM_MAX_ITERATIONS=100

# =============================================================================
# EPIC AUTOMATION - autoBMAD Configuration
# =============================================================================

# Source code directory for epic_automation quality checks
# Default: "src", For DocuSwarm: "docuswarm"
EPIC_SOURCE_DIR=docuswarm

# Test directory for epic_automation pytest execution
# Default: "tests"
EPIC_TEST_DIR=tests
